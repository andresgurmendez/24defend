# URL base de la API. En desarrollo (.env.development) apunta a un backend
# local por defecto — nunca a prod, para que la dashboard_api_key que
# tipeás en dev no viaje por el backend compartido. En producción
# (.env.production) apunta al dominio real; el backend debe permitir ese
# origin vía CORS (ver backend/app/config.py → dashboard_cors_origins).
VITE_API_BASE_URL=http://localhost:8080
