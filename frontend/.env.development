# Local dev talks to a local backend by default — NOT prod — so the
# dashboard key you type in dev never round-trips through the shared prod
# API (PR #14 review finding #5). Run the backend locally:
#   cd backend && .venv/bin/uvicorn app.main:app --reload --port 8080
# and add http://localhost:5173 to DEFEND_DASHBOARD_CORS_ORIGINS in its env.
#
# If you don't want to run a local backend, override this in a
# .env.development.local (gitignored) to point at a shared dev API instead —
# never repoint it at prod.
VITE_API_BASE_URL=http://localhost:8080
